    bm_trade_fee = s.bm_trade_fee
    class_machine = s.class_machine
    class_mounted = s.class_mounted
    t_heal_pct = s.t_heal_pct
    t_kill_gold = s.t_kill_gold
    t_slow_on_hit = s.t_slow_on_hit
    t_min_range = s.t_min_range
    t_splash = s.t_splash
    t_pass_len = s.t_pass_len
    t_buildings_only = s.t_buildings_only
    t_unpack = s.t_unpack
    t_pack = s.t_pack
    t_blast = s.t_blast
    t_blast_line = s.t_blast_line
    t_eval_sight = s.t_eval_sight
    t_sight_add = s.t_sight_add
    t_machine = s.t_machine
    t_mounted = s.t_mounted
    tokens = s.tokens
    tp = s.tp
    market_price = s.market_price
    r_repair_speed = s.r_repair_speed
    r_repair_cost = s.r_repair_cost
    r_trade_min = s.r_trade_min
    r_trade_sq_div = s.r_trade_sq_div
    r_trade_lin_pct = s.r_trade_lin_pct
    pour_at = s.pour_at
    pour_ids = s.pour_ids
    t_docks = s.t_docks
    net_cache = s.net_cache
    net_cache_tick = s.net_cache_tick
    scenario_mode = s.scenario_mode
    cmds = s.cmds
    next_cmd = s.next_cmd
    pending = s.pending
    next_seq = s.next_seq
    trace_tick = s.trace_tick
    su_sides = s.su_sides
    su_rules = s.su_rules
    su_classes = s.su_classes
    su_btypes = s.su_btypes
    su_btype_ids = s.su_btype_ids
    su_research = s.su_research
    su_ages = s.su_ages
    su_units = s.su_units
    su_type_animal = s.su_type_animal
    su_map = s.su_map
    su_bridge_rects = s.su_bridge_rects
    su_rng = s.su_rng
    su_fx = s.su_fx
    ai_tokens = s.ai_tokens
    su_races = s.su_races
    cfg_nums.clear()
    cfg_strs.clear()
    sight_cache.clear()
    ray_offs.clear()
    ray_par.clear()
    s.cfg_nums.forkv() k, v: cfg_nums.set(k, v)
    s.cfg_strs.forkv() k, v: cfg_strs.set(k, v)
    s.sight_cache.forkv() k, v: sight_cache.set(k, v)
    s.ray_offs.forkv() k, v: ray_offs.set(k, v)
    s.ray_par.forkv() k, v: ray_par.set(k, v)
    pad_saved_columns()  // (a save from an older build: its missing per-unit and per-building columns, D-141)
    roles_from_data()    // (... and its building types' roles, D-192)
    staples_from_data()  // (... and its staple resources)
    spatial_clear()      // (... and its spatial buckets, which an older build filled over the whole map)
    return s.bots

// Brings a loaded save up to SAVE_FORMAT: each format change adds its step in gen_reset.lobster, oldest first. Format 1 needs none.
def save_upgrade(s:WorldSave):
    assert s.save_format <= SAVE_FORMAT
    if s.save_format < 2:  // (weapon mounts, #177, #211: no unit type had one)
        for(s.t_slot):
            s.t_mounts.push([]::Mount)
        let old_shots = s.shots  // (a shot says which mount fired it, #179)
        s.shots = []::int
        for(old_shots) v, n:
            s.shots.push(v)
            if n % 11 == 10: s.shots.push(0)
    if s.save_format < 3:  // (aircraft, #183: no unit type was one)
        for(s.t_slot):
            s.t_air.push(0)
            s.t_hits_air.push(0)
    if s.save_format < 4:  // (the table replaced races, #195)
        s.su_units = map(s.su_type_eval) e, k: race_unit(s.su_type_recipe[k], e, s.su_type_line[k])
        s.su_sides = map(s.su_races) race, p:
            let side = race_to_side(race)
            set(side, "lacks", at(s.su_idents[p], "lacks"))  // (a mode may have lifted some)
            side

// Why this save file can't load here, or "".
def save_refusal_of(path:string) -> string:
    let data = read_file(path, true)
    if not data: return "No such save."
    let w, err = flexbuffers_binary_to_value(typeof WorldSave, data)
    if err: return "That file is not a save."
    let s = w
    if not s: return "That file is not a save."
    return save_refusal(s.save_format, s.save_packs)
